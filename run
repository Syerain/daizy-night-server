#!/bin/sh
set -e

PORT=4703

# 1. 检查端口占用，若有则清理
if lsof -iTCP:$PORT -sTCP:LISTEN >/dev/null 2>&1; then
	echo "端口 $PORT 被占用，正在清理..."
	PID=$(lsof -tiTCP:$PORT -sTCP:LISTEN)
	kill -9 $PID && echo "已终止进程 PID: $PID"
else
	echo "端口 $PORT 空闲"
fi

# 2. 删除测试数据库文件
if [ -f ./test/data.db ]; then
	rm -f ./test/data.db && echo "已删除 ./test/data.db"
else
	echo "./test/data.db 不存在，跳过删除"
fi

# 3. 启动 server
echo "启动 server ..."
go run ./cmd/main.go

