#!/bin/sh
set -e

PORT=4703

# 1. 检查端口占用，若有则清理（netstat 兼容 Windows/Git Bash）
if netstat -ano | grep -q ":$PORT .*LISTENING"; then
	PID=$(netstat -ano | grep ":$PORT" | grep LISTENING | awk '{print $NF}' | head -n1)
	echo "端口 $PORT 被占用，正在清理... PID=$PID"
	taskkill //F //PID $PID >/dev/null 2>&1 || true
	sleep 1
else
	echo "端口 $PORT 空闲"
fi

# 2. 删除测试数据库文件（进程退出后文件句柄释放有延迟，带重试）
for i in 1 2 3; do
	if [ -f ./data.db ]; then
		rm -f ./data.db && echo "已清理 ./data.db" && break
	fi
	sleep 1
done

# 3. 启动 server
echo "启动 server ..."
go run ./cmd/main.go

